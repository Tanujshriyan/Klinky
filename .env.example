# Required in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Optional
JWT_EXPIRE_HOURS=168
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000

# Optional S3 presign (leave blank for mock uploads)
S3_BUCKET=
S3_REGION=eu-west-1
S3_PUBLIC_BASE_URL=

# Admin moderation (required for /admin routes)
# Generate ADMIN_PASSWORD_HASH:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-secure-password', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_JWT_EXPIRE_HOURS=8
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_WINDOW_SECONDS=300
